{
  "name": "banchecker-bot",
  "version": "1.0.0",
  "description": "Bot de Telegram para verificar y monitorear bans de WhatsApp",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "docker:build": "docker build -t banchecker-bot .",
    "docker:run": "docker run --rm -it --env-file .env -v $(pwd)/wa_session:/app/wa_session banchecker-bot"
  },
  "dependencies": {
    "@mr-supun-fernando/supunmd-bail": "^3.0.3",
    "@octokit/rest": "^20.1.1",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.5",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
